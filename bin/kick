#!/usr/bin/env bash
# Watch Kick live (streamlink→mpv) or VOD (mpv+yt-dlp).
set -euo pipefail

# shellcheck disable=SC1091
[[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/kick/config" ]] && source "${XDG_CONFIG_HOME:-$HOME/.config}/kick/config"
QUALITY="${QUALITY:-best}"
PIN="${PIN:-0}"   # 1 = show window on all workspaces (Hyprland); toggle in-player with `P`

usage() {
  cat <<'EOF'
Usage:
  kick <channel>                 # live, e.g. kick xqc
  kick <kick-url>                # live or VOD URL
  QUALITY=720p60 kick <channel>

Examples:
  kick xqc
  kick https://kick.com/xqc
  kick https://kick.com/maddyson/videos/<uuid>
EOF
}

[[ $# -lt 1 || "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }

arg="$1"
[[ $# -ge 2 && "$2" != http* ]] && QUALITY="$2"

if [[ "$arg" == http* ]]; then
  url="$arg"
else
  url="https://kick.com/${arg#@}"
fi

# ?offlineVideo=UUID → /videos/UUID
if [[ "$url" =~ kick\.com/([^/?]+)\?.*offlineVideo=([^&]+) ]]; then
  url="https://kick.com/${BASH_REMATCH[1]}/videos/${BASH_REMATCH[2]}"
fi

title="${url#*kick.com/}"; title="${title%%[/?]*}"
mpv_opts=(--force-window=immediate --force-media-title="$title")
[[ "$PIN" == 1 ]] && mpv_opts+=(--script-opts-append=kick-pin=yes)

if [[ "$url" == */videos/* ]]; then
  echo "VOD → mpv + yt-dlp"
  echo "$url  [$QUALITY]"
  exec mpv "${mpv_opts[@]}" --ytdl-format="$QUALITY" "$url"
fi

echo "Live → streamlink → mpv"
echo "$url  [$QUALITY]"
if ! streamlink --stream-url "$url" "$QUALITY" >/dev/null; then
  echo "Stream not found (channel offline?). For VOD use /videos/<uuid> URL." >&2
  exit 1
fi

exec streamlink -p mpv -a "${mpv_opts[*]} -- {playerinput}" "$url" "$QUALITY"
